# ============================================================
# أكاديمية الغزاوي — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم. لا تشارك .env.local.
# القيم من: Supabase → Project Settings → API
# ============================================================

# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key (سرّي — للخادم فقط، لا يبدأ بـ anon)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ============================================================
# كود المالك ولوحة التحكم (المرحلة 4)
# ============================================================
# كود المالك — أدخِله في أي نموذج تفعيل ليفتح لك كل شيء + الطباعة (سرّي، اختر قيمة قوية)
OWNER_CODE=AGZ-OWNER-XXXXXX

# كلمة سر لوحة التحكم على /admin (سرّية، اختر قيمة قوية)
ADMIN_PASSWORD=change-me-to-a-strong-password
